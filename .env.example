# ==== Общие ====
ENVIRONMENT=development
LOG_LEVEL=INFO
TZ=UTC

# ==== База данных (SQLite, WAL) ====
DATABASE_PATH=/data/raffle.db
DB_BUSY_TIMEOUT_MS=5000

# ==== JWT ====
JWT_SECRET=change-me-to-a-random-64-char-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ==== Бутстрап первого Super Admin (используется один раз, если PanelUser пуст) ====
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=change-me-strong-password

# ==== Платёжные провайдеры ====
# requisites_qr | tbank | vtb | mock
# По продуктовому решению интернет-эквайринг (tbank/vtb) в этой версии не
# используется — оставлен в коде выключенным (см. DECISIONS.md). Активный
# провайдер по умолчанию — requisites_qr (статический QR по реквизитам,
# ГОСТ Р 56042-2014 / ST00012, оплата вручную участником + сверка по выписке).
PAYMENT_PROVIDER=requisites_qr

# ---- requisites_qr: реквизиты получателя для QR (ГОСТ Р 56042-2014, ST00012) ----
REQUISITES_RECIPIENT_NAME=
REQUISITES_RECIPIENT_INN=
# Пусто, если получатель — ИП без КПП
REQUISITES_RECIPIENT_KPP=
REQUISITES_PERSONAL_ACC=
REQUISITES_BANK_NAME=
REQUISITES_BIC=
REQUISITES_CORR_ACC=
# Ставка НДС, % (0 = "НДС не облагается", напр. УСН) — используется для приписки
# в назначении платежа "в т.ч. НДС X% ... руб."
REQUISITES_VAT_RATE_PERCENT=20
# Неоплаченный счёт (нет совпадения в выписке) считается просроченным и
# помечается FAILED через столько дней — резерва номерков нет, освобождать
# нечего, просто уменьшается сумма в лимите ожидающих экземпляров (см. ниже,
# DECISIONS_LOG.md №45)
REQUISITES_INVOICE_TTL_DAYS=14
# Лимит суммарного количества экземпляров во всех текущих неоплаченных покупках
# участника (платежи + ручные регистрации, глобально по всем розыгрышам) —
# отменяет прежнее бинарное правило "не более одной активной покупки" (DECISIONS_LOG.md №45)
MAX_PENDING_TICKETS_PER_PARTICIPANT=20

# ---- Сверка через выписку Т-Банк (T-API), см. DECISIONS.md — по документации,
# без реального прогона (нет тестовых доступов Т-Бизнес) ----
TBANK_STATEMENT_API_BASE=https://business.tbank.ru/openapi/api/v1
TBANK_STATEMENT_API_TOKEN=
TBANK_STATEMENT_ACCOUNT_NUMBER=
# Глубина окна для батч-сверки за один тик фоновой задачи — держать >= значения
# REQUISITES_INVOICE_TTL_DAYS выше, иначе неоплаченный счёт может выпасть из
# окна выписки до истечения TTL и никогда не будет сопоставлен с реальной оплатой
BANK_STATEMENT_LOOKBACK_DAYS=14
# Сколько дней хранить историю тиков сверки (панель статуса «Сверка выписок» в
# «Продажи», Administrator+) — старые строки удаляются автоматически на каждом тике
BANK_RECONCILIATION_RUN_RETENTION_DAYS=30

# ---- Квитанции, присланные участниками (не распознаются, только хранятся) ----
RECEIPTS_DIR=/data/receipts

# ---- Цифровые постеры розыгрышей, загружаемые через веб-админку ----
POSTER_DIR=/data/posters

# ==== Резервирование / TTL ====
# ONLINE_* ниже реально не используются ни одним активным провайдером —
# интернет-эквайринг (единственный, кто резервировал номерки "на лету", см.
# BasePaymentProvider.reserves_tickets_on_create) удалён по прямому запросу
# заказчика (DECISIONS_LOG.md №44); настройки оставлены как безвредная неиспользуемая
# инфраструктура. requisites_qr использует REQUISITES_INVOICE_TTL_DAYS/
# BANK_STATEMENT_LOOKBACK_DAYS выше вместо этого. MANUAL_RESERVATION_TTL_SEC —
# отдельная, действующая настройка для ручной регистрации оператором.
ONLINE_STATUS_POLL_INTERVAL_SEC=60
ONLINE_STATUS_POLL_MAX_ATTEMPTS=10
ONLINE_RESERVATION_TTL_SEC=600
MANUAL_RESERVATION_TTL_SEC=3600

# ==== Telegram-канал ====
TELEGRAM_BOT_TOKEN=
# TELEGRAM_PROXY_URL сюда вписывать не нужно — channel-telegram ходит к Bot API
# через socks5://ssh-tunnel:$SSH_TUNNEL_LOCAL_PORT (собирается в docker-compose.yml
# из переменных ниже). Поле telegram_proxy_url в app/core/config.py остаётся общим
# passthrough-механизмом (полезно для локального запуска без Docker/туннеля — можно
# временно указать сюда любой HTTP/SOCKS5-прокси через .env).
TELEGRAM_PROXY_URL=

# ---- SSH-туннель для Telegram-канала (вместо стороннего прокси, DECISIONS_LOG.md №71) ----
# Динамический SOCKS5-форвардинг (`ssh -D`) через sidecar-контейнер ssh-tunnel на уже
# существующий удалённый хост с доступом к api.telegram.org, авторизация по ключу.
#
# Настройка:
#   1. Сгенерировать НОВУЮ ключевую пару (не переиспользовать ключ backup-host из
#      RESTIC_* — разное назначение):
#        ssh-keygen -t ed25519 -f data/ssh/telegram_tunnel_ed25519 -N "" \
#          -C "poster-diesel-bot-telegram-tunnel"
#   2. Добавить публичный ключ (data/ssh/telegram_tunnel_ed25519.pub) в
#      ~/.ssh/authorized_keys удалённого хоста, желательно с ограничениями:
#        no-pty,no-agent-forwarding,no-X11-forwarding,permitopen="api.telegram.org:443" ssh-ed25519 AAAA...
#      (нужен пользователь с AllowTcpForwarding yes в sshd_config удалённого хоста)
#   3. Запинить отпечаток хоста (обязательно — StrictHostKeyChecking=yes):
#        ssh-keyscan -p $SSH_TUNNEL_PORT $SSH_TUNNEL_HOST >> data/ssh/known_hosts
#   4. Заполнить SSH_TUNNEL_HOST/PORT/USER ниже.
# data/ssh/ уже в .gitignore (правило /data/*) — ключи и known_hosts не коммитятся.
SSH_TUNNEL_HOST=
SSH_TUNNEL_PORT=22
SSH_TUNNEL_USER=
SSH_TUNNEL_LOCAL_PORT=1080
SSH_TUNNEL_PRIVATE_KEY_PATH=./data/ssh/telegram_tunnel_ed25519
SSH_TUNNEL_KNOWN_HOSTS_PATH=./data/ssh/known_hosts

# ==== VK-канал (см. DECISIONS_LOG.md #32/#33) ====
VK_GROUP_TOKEN=
VK_GROUP_ID=

# ==== Reverse-proxy / доступ к панели ====
PANEL_DOMAIN=panel.example.com
# Список IP/CIDR через пробел (Caddy remote_ip matcher — не запятая)
PANEL_IP_WHITELIST=127.0.0.1 10.0.0.0/8
ACME_EMAIL=admin@example.com

# ==== Резервное копирование ====
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14

# ---- Полное офсайт-резервное копирование (scripts/full_backup.sh, restic; см. ARCHITECTURE.md §8) ----
# Локальный restic-репозиторий (шифрованный), при почасовом запуске хранится RESTIC_LOCAL_KEEP_WITHIN.
RESTIC_LOCAL_REPO=./data/restic-local
# Офсайт-репозиторий restic на другом сервере по SSH/SFTP. "backup-host" — алиас из
# ~/.ssh/config (см. ARCHITECTURE.md §8), путь без ведущего "/" — относительно домашней
# директории resticbackup на офсайт-сервере.
RESTIC_REMOTE_REPO=sftp:backup-host:restic-repo
# Файл с паролем шифрования restic-репозиториев — НЕ коммитить, chmod 600, хранить вне каталога проекта
RESTIC_PASSWORD_FILE=/opt/raffle-platform/.restic-password
RESTIC_LOCAL_KEEP_WITHIN=1d
RESTIC_REMOTE_KEEP_HOURLY=24
RESTIC_REMOTE_KEEP_DAILY=30
