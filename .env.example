# ==== Общие ====
ENVIRONMENT=development
LOG_LEVEL=INFO
TZ=UTC

# ==== База данных (SQLite, WAL) ====
DATABASE_PATH=/data/raffle.db
DB_BUSY_TIMEOUT_MS=5000

# ==== JWT ====
JWT_SECRET=change-me-to-a-random-64-char-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ==== Бутстрап первого Super Admin (используется один раз, если PanelUser пуст) ====
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=change-me-strong-password

# ==== Платёжные провайдеры ====
# tbank | vtb | mock
PAYMENT_PROVIDER=mock
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=
TBANK_API_BASE=https://securepay.tinkoff.ru/v2
VTB_MERCHANT_ID=
VTB_SECRET_KEY=
VTB_API_BASE=https://api.vtb.ru/acquiring

# ==== Резервирование / TTL ====
ONLINE_STATUS_POLL_INTERVAL_SEC=60
ONLINE_STATUS_POLL_MAX_ATTEMPTS=10
ONLINE_RESERVATION_TTL_SEC=600
MANUAL_RESERVATION_TTL_SEC=3600

# ==== Telegram-канал ====
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=

# ==== Reverse-proxy / доступ к панели ====
PANEL_DOMAIN=panel.example.com
# Список IP/CIDR через пробел (Caddy remote_ip matcher — не запятая)
PANEL_IP_WHITELIST=127.0.0.1 10.0.0.0/8
ACME_EMAIL=admin@example.com

# ==== Резервное копирование ====
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
