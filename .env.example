# ==== Общие ====
ENVIRONMENT=development
LOG_LEVEL=INFO
TZ=UTC

# ==== База данных (SQLite, WAL) ====
DATABASE_PATH=/data/raffle.db
DB_BUSY_TIMEOUT_MS=5000

# ==== JWT ====
JWT_SECRET=change-me-to-a-random-64-char-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ==== Бутстрап первого Super Admin (используется один раз, если PanelUser пуст) ====
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=change-me-strong-password

# ==== Платёжные провайдеры ====
# requisites_qr | tbank | vtb | mock
# По продуктовому решению интернет-эквайринг (tbank/vtb) в этой версии не
# используется — оставлен в коде выключенным (см. DECISIONS.md). Активный
# провайдер по умолчанию — requisites_qr (статический QR по реквизитам,
# ГОСТ Р 56042-2014 / ST00012, оплата вручную участником + сверка по выписке).
PAYMENT_PROVIDER=requisites_qr

# ---- requisites_qr: реквизиты получателя для QR (ГОСТ Р 56042-2014, ST00012) ----
REQUISITES_RECIPIENT_NAME=
REQUISITES_RECIPIENT_INN=
# Пусто, если получатель — ИП без КПП
REQUISITES_RECIPIENT_KPP=
REQUISITES_PERSONAL_ACC=
REQUISITES_BANK_NAME=
REQUISITES_BIC=
REQUISITES_CORR_ACC=
# Ставка НДС, % (0 = "НДС не облагается", напр. УСН) — используется для приписки
# в назначении платежа "в т.ч. НДС X% ... руб."
REQUISITES_VAT_RATE_PERCENT=20
# Неоплаченный счёт (нет совпадения в выписке) считается просроченным и
# помечается FAILED через столько дней — резерва номерков нет, освобождать
# нечего, просто снимается блокировка "одна активная покупка" (DECISIONS.md №22)
REQUISITES_INVOICE_TTL_DAYS=14

# ---- Сверка через выписку Т-Банк (T-API), см. DECISIONS.md — по документации,
# без реального прогона (нет тестовых доступов Т-Бизнес) ----
TBANK_STATEMENT_API_BASE=https://business.tbank.ru/openapi/api/v1
TBANK_STATEMENT_API_TOKEN=
TBANK_STATEMENT_ACCOUNT_NUMBER=
# Глубина окна для батч-сверки за один тик фоновой задачи — держать >= значения
# REQUISITES_INVOICE_TTL_DAYS выше, иначе неоплаченный счёт может выпасть из
# окна выписки до истечения TTL и никогда не будет сопоставлен с реальной оплатой
BANK_STATEMENT_LOOKBACK_DAYS=14

# ---- Квитанции, присланные участниками (не распознаются, только хранятся) ----
RECEIPTS_DIR=/data/receipts

# ---- Интернет-эквайринг (НЕ используется по умолчанию, см. DECISIONS.md) ----
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=
TBANK_API_BASE=https://securepay.tinkoff.ru/v2
# Параметры фискального чека (Receipt), обязательного в каждом запросе Init.
# ВАЖНО: значения ниже — заглушка, заказчик обязан выставить реальные согласно
# своей системе налогообложения/регистрации в личном кабинете эквайринга.
# Taxation: osn | usn_income | usn_income_outcome | envd | esn | patent
TBANK_RECEIPT_TAXATION=usn_income
# Tax (ставка НДС на позицию): none | vat0 | vat10 | vat20 | vat110 | vat120
TBANK_RECEIPT_TAX=none
# PaymentMethod: full_prepayment | prepayment | advance | full_payment | partial_payment | credit | credit_payment
TBANK_RECEIPT_PAYMENT_METHOD=full_payment
# PaymentObject: commodity | service | payment | another | ... (НЕ lottery/gambling_bet — условия эквайринга это запрещают)
TBANK_RECEIPT_PAYMENT_OBJECT=commodity
VTB_MERCHANT_ID=
VTB_SECRET_KEY=
VTB_API_BASE=https://api.vtb.ru/acquiring

# ==== Резервирование / TTL ====
# Актуально только для tbank/vtb/mock (провайдеров с резервированием "на лету" —
# см. BasePaymentProvider.reserves_tickets_on_create) — requisites_qr использует
# REQUISITES_INVOICE_TTL_DAYS/BANK_STATEMENT_LOOKBACK_DAYS выше вместо этого.
ONLINE_STATUS_POLL_INTERVAL_SEC=60
ONLINE_STATUS_POLL_MAX_ATTEMPTS=10
ONLINE_RESERVATION_TTL_SEC=600
MANUAL_RESERVATION_TTL_SEC=3600

# ==== Telegram-канал ====
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=

# ==== VK-канал (см. DECISIONS.md #32/#33) ====
VK_GROUP_TOKEN=
VK_GROUP_ID=

# ==== Reverse-proxy / доступ к панели ====
PANEL_DOMAIN=panel.example.com
# Список IP/CIDR через пробел (Caddy remote_ip matcher — не запятая)
PANEL_IP_WHITELIST=127.0.0.1 10.0.0.0/8
ACME_EMAIL=admin@example.com

# ==== Резервное копирование ====
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
