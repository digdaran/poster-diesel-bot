# Reverse-proxy (production): автоматический HTTPS через Let's Encrypt (ACME),
# IP-whitelist для панели и API. Наружу без ограничения по IP ничего не
# публикуется — банковских webhook-эндпоинтов больше нет (интернет-эквайринг
# удалён, см. DECISIONS_LOG.md №44; подтверждение оплаты теперь только через
# сверку банковской выписки, без входящих запросов от банка). /metrics НЕ
# проксируется наружу (п.19 ТЗ).
#
# Для локальной разработки без реального домена используйте Caddyfile.dev
# (self-signed, `tls internal`) — см. docker-compose.override.yml.
{
	email {$ACME_EMAIL}
}

{$PANEL_DOMAIN} {

    @allowed remote_ip {$PANEL_IP_WHITELIST}

    handle @allowed {

        handle /api/* {
            reverse_proxy backend:8000
        }

        handle {
            reverse_proxy frontend:80
        }
    }

    respond 403
}
